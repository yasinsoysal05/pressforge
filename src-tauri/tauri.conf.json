{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PressForge",
  "version": "0.2.0",
  "identifier": "dev.pressforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PressForge — WordPress Studio",
        "width": 1260,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620,
        "backgroundColor": "#0b1020"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/runtime/": "runtime/"
    }
  }
}
